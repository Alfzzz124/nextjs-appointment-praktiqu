# ===========================================
# PraktiQU Production Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values
# ===========================================

# ===========================================
# DATABASE (Prisma - MySQL)
# ===========================================
DATABASE_URL="mysql://user:password@host:3306/praktiqu"

# ===========================================
# WORDPRESS INTEGRATION
# ===========================================
WORDPRESS_DATABASE_URL="mysql://user:password@host:3306/wordpress"
WORDPRESS_TABLE_PREFIX="wp_"
WORDPRESS_URL="https://your-wordpress-site.com"
WORDPRESS_AUTH_SYNC="true"

# Service-to-service auth header for the custom WP REST endpoint
WORDPRESS_SERVICE_TOKEN="generate-secure-token-here"

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-production-auth-secret-here"

# Shared secret that lets the Laravel FE (terpadu.praktiqu.com) pass the browser's IP.
# The FE calls this API server-side, so without it every FE request looks like it comes
# from the FE host: rate limits collapse to per-email and audit_logs.ip is useless.
# The FE sends X-Praktiqu-Client-Ip plus X-Praktiqu-Forwarder-Key = this value. Unset
# (or shorter than 16 chars) = feature off. Generate with: openssl rand -base64 32
# FE_FORWARDER_SECRET=""

# Public application URL (use your actual domain)
AUTH_URL="https://your-domain.com"
NEXTAUTH_URL="https://your-domain.com"
AUTH_TRUST_HOST="true"

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_NAME="PraktiQU"
DEFAULT_TIMEZONE="Asia/Jakarta"
DEFAULT_PAGE_SIZE="20"
MAX_PAGE_SIZE="100"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL="INFO"

# ===========================================
# EMAIL (Production)
# ===========================================
EMAIL_FROM="noreply@your-domain.com"
SMTP_HOST="smtp.your-email-provider.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@your-domain.com"
SMTP_PASS="your-email-password"

# ===========================================
# DEPLOYMENT
# ===========================================
NODE_ENV="production"
PORT=3000
HOST="0.0.0.0"

# ===========================================
# DEVELOPMENT-ONLY — DO NOT SET IN PRODUCTION
# ===========================================
# EMAIL_DEV_LOG_BODY controls a local-dev-only fallback log in sendEmail() that only
# fires when RESEND_API_KEY is empty (which it must not be here). If ever set to "true"
# it would write the email subject/body — including the OTP sign-in code — to logs in
# plain text. Leave unset in production; it must never be "true" here.
# EMAIL_DEV_LOG_BODY="true"